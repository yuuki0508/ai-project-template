# ---- Supabase（make up 実行時に表示される値を貼る）----
# コンテナ内から見たローカルDB
DATABASE_URL="postgresql://postgres:postgres@host.docker.internal:__PORT_DB__/postgres"
DIRECT_URL="postgresql://postgres:postgres@host.docker.internal:__PORT_DB__/postgres"

# ブラウザから使う（公開されて良い値のみ）
NEXT_PUBLIC_SUPABASE_URL=http://localhost:__SB_API__
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ★ API（サーバー）専用。フロントに渡さない
SUPABASE_SERVICE_ROLE_KEY=

# ---- 本番（Vercel等の環境変数に設定する。ここには書かない）----
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:__PORT_API__
