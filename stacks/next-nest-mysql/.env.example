# ---- DB ----
# compose.yml はこの値を参照する。パスワードをここ以外に書かないこと。
# DATABASE_URL は compose.yml 側でこの3つから組み立てられる（二重管理を避けるため）
# ローカル専用の既定値。本番の値はデプロイ先の環境変数に置く（このファイルに書かない）
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_NAME__
DB_PASSWORD=secret
# phpMyAdmin から root でログインする際に使う
DB_ROOT_PASSWORD=secret

NODE_ENV=development
PORT=4000

# ブラウザから見えるURL（web用）
NEXT_PUBLIC_API_URL=http://localhost:__PORT_API__

MAIL_HOST=mail
MAIL_PORT=1025
MAIL_FROM="noreply@example.com"

JWT_SECRET=change-me-in-production
