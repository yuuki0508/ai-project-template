APP_NAME=__PROJECT_SLUG__
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tokyo
APP_URL=http://localhost:__PORT_WEB__

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en

# ---- DB ----
# compose.yml はこの値を参照する。パスワードをここ以外に書かないこと。
# ローカル専用の既定値。本番の値はデプロイ先の環境変数に置く（このファイルに書かない）
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_NAME__
DB_PASSWORD=secret
# phpMyAdmin から root でログインする際に使う
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@example.com"
